# Black Duck (Synopsys Detect) — optional, only needed if using Black Duck as scanner
# Get token: Black Duck UI > User tab > Access My Tokens > Create (Read+Write)
BLACKDUCK_URL=https://redhathub.blackducksoftware.com
BLACKDUCK_API_TOKEN=your-token-here

# Lightwell credentials are stored in ~/.netrc (not here).
# The setup script reads the token from ~/.netrc and generates settings.xml.
# Format in ~/.netrc: machine packages.redhat.com login <username> password <token>
# See: https://docs.redhat.com/en/documentation/red_hat_lightwell_network/current/configure-configure_java_build_tool
